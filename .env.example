# BYOK — keys are normally entered in Settings (stored in your browser) and
# sent per-request. These env vars are only a server-side fallback.

# OpenRouter (strictly free :free models)
OPENROUTER_API_KEY=
# Groq (strictly free-tier models)
GROQ_API_KEY=
# DeepSeek / OpenAI (not free — billed to your key)
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# Stripe is only needed for /api/webhook/stripe (not hit during normal use).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
