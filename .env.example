# NOTE: this version calls OpenRouter directly — put an OpenRouter key here,
# even though the env var is named OPENAI_API_KEY. (Free models are used as fallback.)
OPENAI_API_KEY=your-openrouter-key-here

# Stripe is only needed for the /api/webhook/stripe route (not hit during normal use).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
