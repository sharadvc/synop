generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db?connection_limit=1&timeout=5000"
}

model Summary {
  id               String   @id @default(cuid())
  videoId          String
  language         String   @default("English")
  title            String
  channel          String
  duration         String
  status           String   @default("Completed")
  executiveSummary String
  keyInsights      String
  actionItems      String
  quotes           String
  timestamps       String
  resources        String
  verdict          String
  biasAnalysis     String?
  frameworks       String?
  entities         String?
  mindMap          String?
  folderId         String?
  folder           Folder?  @relation(fields: [folderId], references: [id])
  tags             Tag[]
  blogPost         String?
  twitterThread    String?
  linkedinPost     String?
  notes            String?
  transcript       String?
  createdAt        DateTime @default(now())
}

model Folder {
  id        String    @id @default(cuid())
  name      String
  color     String?   @default("gray")
  summaries Summary[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Tag {
  id        String    @id @default(cuid())
  name      String    @unique
  color     String?   @default("blue")
  summaries Summary[]
  createdAt DateTime  @default(now())
}
