generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String    @id
  credits   Int       @default(5)
  summaries Summary[]
}

model Summary {
  id               String   @id @default(cuid())
  userId           String
  videoId          String
  title            String
  channel          String
  duration         String
  status           String   @default("Completed")
  executiveSummary String
  keyInsights      String
  actionItems      String
  quotes           String
  timestamps       String
  resources        String
  verdict          String
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}
